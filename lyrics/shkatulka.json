[
  { "time": 14.5, "text": "Чёрная шкатулка на витрине за стеклом", "style": "chill" },
  { "time": 18.0, "text": "Девочка-загадка, ключик заводной", "style": "chill" },
  { "time": 21.5, "text": "Радуются дети причудливой игрушке", "style": "chill" },
  { "time": 25.0, "text": "А старик-хозяин грустно качает головой", "style": "chill" },
  
  { "time": 29.0, "text": "За окном стоял ты, глядя на меня", "style": "default" },
  { "time": 32.5, "text": "Будто бы пытался игрушку ты понять", "style": "default" },
  { "time": 36.0, "text": "Будто привлекал не причудливый узор", "style": "default" },
  { "time": 40.0, "text": "А мой одинокий вальс си минор", "style": "chill" },

  { "time": 43.5, "text": "В тот же миг изменился твой взор", "style": "default" },
  { "time": 47.0, "text": "Другом тебе стал холодный фарфор", "style": "default" },
  { "time": 50.5, "text": "Если бы ты только знал...", "style": "chill" },
  { "time": 54.0, "text": "ЕСЛИ БЫ ТЫ ТОЛЬКО ЗНАЛ", "style": "rage" },
  { "time": 57.5, "text": "Что с монстром свою ты жизнь связал", "style": "rage" },

  { "time": 61.5, "text": "Дни летели как минуты, рядом были мы всегда", "style": "default" },
  { "time": 65.0, "text": "Помню, как ночами вальс мой убаюкивал тебя", "style": "default" },
  { "time": 68.5, "text": "Стал ты мне отцом и братом, ощущала я себя живой", "style": "default" },
  { "time": 72.0, "text": "А со временем я стала одержима тобой...", "style": "chill" },
  { "time": 74.5, "text": "ТЕМ, ЧТО ТЫ — ЛИШЬ ТОЛЬКО МОЙ", "style": "rage" },

  { "time": 76.5, "text": "И я не хочу ни с кем делить тебя", "style": "rage" },
  { "time": 80.0, "text": "Умоляю, заведи меня!", "style": "rage" },
  { "time": 83.5, "text": "Ключик поверни, боже, да!", "style": "rage" },
  { "time": 87.0, "text": "Я СХОЖУ С УМА, Я СХОЖУ С УМА!", "style": "rage" },

  { "time": 90.5, "text": "Вечно будет длиться сказка", "style": "default" },
  { "time": 94.0, "text": "Шепот, слёзы, ах, как сладко!", "style": "default" },
  { "time": 97.5, "text": "Вслушайся ещё разок...", "style": "chill" },
  { "time": 101.0, "text": "В мелодию си минор", "style": "chill" },

  { "time": 105.0, "text": "Как так получилось? Как же вышло так?", "style": "chill" },
  { "time": 108.5, "text": "Задели — я разбилась, казалось бы, пустяк…", "style": "chill" },
  { "time": 112.0, "text": "Кончилась музыка, рассыпался бал", "style": "chill" },
  { "time": 115.5, "text": "Вальс из шкатулки с тех пор не играл", "style": "chill" },
  { "time": 119.5, "text": "Выкинул меня в чулан ты, как надоевшую игрушку", "style": "chill" },
  { "time": 124.0, "text": "Я никогда не прощу тебя...", "style": "rage" },

  { "time": 126.5, "text": "ВЕРИЛА, ВЕРИЛА, А ТЫ МЕНЯ ПРЕДАЛ!", "style": "rage" },
  { "time": 130.0, "text": "ЧТО Я ТЕБЕ СДЕЛАЛА?! Я ЖЕ ЛЮБЛЮ ТЕБЯ!", "style": "rage" },
  { "time": 133.5, "text": "НЕТ, НЕНАВИЖУ! ТЫ СДЕЛАЛ МНЕ БОЛЬНО!", "style": "rage" },
  { "time": 137.0, "text": "ТЕПЕРЬ МОЯ ОЧЕРЕДЬ, ХВАТИТ! ХВАТИТ!", "style": "rage" },
  { "time": 139.5, "text": "ДОВОЛЬНО!", "style": "rage" },

  { "time": 141.0, "text": "Твоя боль — какая сказка!", "style": "rage" },
  { "time": 144.5, "text": "Крики, слёзы, ах как сладко!", "style": "rage" },
  { "time": 148.0, "text": "БОЖЕ, СНОВА, ГРОМЧЕ, ГРОМЧЕ!", "style": "rage" },
  { "time": 151.5, "text": "Ещё парочку минут...", "style": "default" },

  { "time": 155.0, "text": "Мило давишься слезами, словно теми ночами", "style": "default" },
  { "time": 160.0, "text": "Скоро сердце биться перестанет...", "style": "chill" },
  { "time": 165.0, "text": "Но наши чувства не умрут", "style": "chill" },

  { "time": 170.0, "text": "Тише, я здесь, я с тобой...", "style": "chill" },
  { "time": 175.0, "text": "Скажи, тебе больно?", "style": "chill" },
  { "time": 178.0, "text": "Мне тоже, дорогой…", "style": "chill" },
  { "time": 182.0, "text": "Не отдам тебя я смерти, ты достоин жить!", "style": "default" },
  { "time": 187.0, "text": "Будем мы с тобою вместе...", "style": "chill" },
  { "time": 191.0, "text": "В вальсе си минор кружить", "style": "chill" }
]
