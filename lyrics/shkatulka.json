[
  { "time": 20.0, "text": "Чёрная шкатулка", "style": "chill" },
  { "time": 21.0, "text": "на витрине за стеклом", "style": "chill" },
  { "time": 25.0, "text": "Девочка-загадка,", "style": "chill" },
  { "time": 28.0, "text": "ключик заводной", "style": "chill" },
  { "time": 30.0, "text": "Радуются дети причудливой игрушке", "style": "chill" },
  { "time": 35.0, "text": "А старик-хозяин грустно качает головой", "style": "chill" },
  
  { "time": 40.0, "text": "За окном стоял ты,", "style": "chill" },
  { "time": 43.0, "text": "глядя на меня", "style": "chill" },
  { "time": 45.0, "text": "Будто бы пытался игрушку ты понять", "style": "chill" },
  { "time": 50.0, "text": "Будто привлекал не причудливый узор", "style": "chill" },
  { "time": 55.0, "text": "А мой одинокий вальс си минор", "style": "chill" },

  { "time": 58.5, "text": "В тот же миг изменился твой взор", "style": "default" },
  { "time": 62.0, "text": "Другом тебе стал холодный фарфор", "style": "default" },
  { "time": 65.5, "text": "Если бы ты только знал...", "style": "chill" },
  { "time": 69.0, "text": "ЕСЛИ БЫ ТЫ ТОЛЬКО ЗНАЛ", "style": "rage" },
  { "time": 72.5, "text": "Что с монстром свою ты жизнь связал", "style": "rage" },

  { "time": 76.5, "text": "Дни летели как минуты, рядом были мы всегда", "style": "default" },
  { "time": 80.0, "text": "Помню, как ночами вальс мой убаюкивал тебя", "style": "default" },
  { "time": 83.5, "text": "Стал ты мне отцом и братом, ощущала я себя живой", "style": "default" },
  { "time": 87.0, "text": "А со временем я стала одержима тобой...", "style": "chill" },
  { "time": 89.5, "text": "ТЕМ, ЧТО ТЫ — ЛИШЬ ТОЛЬКО МОЙ", "style": "rage" },

  { "time": 91.5, "text": "И я не хочу ни с кем делить тебя", "style": "rage" },
  { "time": 95.0, "text": "Умоляю, заведи меня!", "style": "rage" },
  { "time": 98.5, "text": "Ключик поверни, боже, да!", "style": "rage" },
  { "time": 102.0, "text": "Я СХОЖУ С УМА, Я СХОЖУ С УМА!", "style": "rage" },

  { "time": 105.5, "text": "Вечно будет длиться сказка", "style": "default" },
  { "time": 109.0, "text": "Шепот, слёзы, ах, как сладко!", "style": "default" },
  { "time": 112.5, "text": "Вслушайся ещё разок...", "style": "chill" },
  { "time": 116.0, "text": "В мелодию си минор", "style": "chill" },

  { "time": 120.0, "text": "Как так получилось? Как же вышло так?", "style": "chill" },
  { "time": 123.5, "text": "Задели — я разбилась, казалось бы, пустяк…", "style": "chill" },
  { "time": 127.0, "text": "Кончилась музыка, рассыпался бал", "style": "chill" },
  { "time": 130.5, "text": "Вальс из шкатулки с тех пор не играл", "style": "chill" },
  { "time": 134.5, "text": "Выкинул меня в чулан ты, как надоевшую игрушку", "style": "chill" },
  { "time": 139.0, "text": "Я никогда не прощу тебя...", "style": "rage" },

  { "time": 141.5, "text": "ВЕРИЛА, ВЕРИЛА, А ТЫ МЕНЯ ПРЕДАЛ!", "style": "rage" },
  { "time": 145.0, "text": "ЧТО Я ТЕБЕ СДЕЛАЛА?! Я ЖЕ ЛЮБЛЮ ТЕБЯ!", "style": "rage" },
  { "time": 148.5, "text": "НЕТ, НЕНАВИЖУ! ТЫ СДЕЛАЛ МНЕ БОЛЬНО!", "style": "rage" },
  { "time": 152.0, "text": "ТЕПЕРЬ МОЯ ОЧЕРЕДЬ, ХВАТИТ! ХВАТИТ!", "style": "rage" },
  { "time": 154.5, "text": "ДОВОЛЬНО!", "style": "rage" },

  { "time": 156.0, "text": "Твоя боль — какая сказка!", "style": "rage" },
  { "time": 159.5, "text": "Крики, слёзы, ах как сладко!", "style": "rage" },
  { "time": 163.0, "text": "БОЖЕ, СНОВА, ГРОМЧЕ, ГРОМЧЕ!", "style": "rage" },
  { "time": 166.5, "text": "Ещё парочку минут...", "style": "default" },

  { "time": 170.0, "text": "Мило давишься слезами, словно теми ночами", "style": "default" },
  { "time": 175.0, "text": "Скоро сердце биться перестанет...", "style": "chill" },
  { "time": 180.0, "text": "Но наши чувства не умрут", "style": "chill" },

  { "time": 185.0, "text": "Тише, я здесь, я с тобой...", "style": "chill" },
  { "time": 190.0, "text": "Скажи, тебе больно?", "style": "chill" },
  { "time": 193.0, "text": "Мне тоже, дорогой…", "style": "chill" },
  { "time": 197.0, "text": "Не отдам тебя я смерти, ты достоин жить!", "style": "default" },
  { "time": 202.0, "text": "Будем мы с тобою вместе...", "style": "chill" },
  { "time": 206.0, "text": "В вальсе си минор кружить", "style": "chill" }
]
